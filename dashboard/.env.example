# All-Vercel mode. Never commit real credentials.
ATLAS_BACKEND=vercel
ATLAS_APP_URL=https://your-project.vercel.app
ATLAS_WORKER_SECRET=
DASHBOARD_PASSWORD=
# Automatically added by the private Blob store connection.
BLOB_READ_WRITE_TOKEN=

# Optional external backend mode (ATLAS_BACKEND=external).
SCRAPER_API_URL=
SCRAPER_API_TOKEN=
