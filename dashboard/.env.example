# Public HTTPS origin of your persistent Google Maps Scraper server.
SCRAPER_API_URL=https://scraper.example.com
# If a reverse proxy protects that server with a bearer token, set the same token here.
# Keep this server-side; never use NEXT_PUBLIC_ or VITE_ for this secret.
SCRAPER_API_TOKEN=

# Required when the scraper is connected. Use a long, unique password.
DASHBOARD_PASSWORD=
